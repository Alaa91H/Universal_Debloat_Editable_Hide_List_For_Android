#!/sbin/sh
# ============================================================================
# Universal Debloat - INTERACTIVE recovery installer (bilingual)
#
# Volume-key menus inside TWRP/OrangeFox:
#   0) Language : English / Arabic       (remembered for next time)
#   1) Preset   : Safe / Default / Maximum / Keep current config
#   2) Action   : Uninstall (hide) / Disable
#   3) CleanROM : skip the first-boot setup wizard?  no / yes
#
# UI contract (tested on a real device):
#   - The currently selected option is ALWAYS shown prefixed with "==>" on its
#     own line. The line is re-printed after every keypress and once when the
#     menu opens, so the screen is never static: you can always see which
#     option you are on and when it changes.
#   - The timeout (15 s) counts from the LAST keypress, not from when the menu
#     opened. Every keypress resets it, so you can take as long as you want.
#   - If no key device can be opened, the menu prints a notice and returns the
#     default after 5 s instead of idling for the full timeout.
#
# The module stays device- and ROM-neutral: paths are discovered at runtime,
# nothing here references a specific product.
# ============================================================================

OUTFD="$2"
ZIPFILE="$3"
MODID="universal_debloat"
CONF=/data/adb/debloat_list.conf
CLEANFLAG=/data/adb/debloat_cleanrom
# NO menu timeout: menus wait indefinitely until Power is pressed.
# (kept as a variable name for the no-input-device probe window only)

ui_print() {
  echo -e "ui_print $1\nui_print" >> /proc/self/fd/$OUTFD
}

abort() {
  ui_print "  ! $1"
  ui_print "  ! Installation aborted"
  sleep 3
  exit 1
}

# ---------------------------------------------------------------------------
# Open every evdev node once. touch input is filtered by key bitmask; volume
# and power are key events on most devices.
# ---------------------------------------------------------------------------
DEVS=""
for ev in /dev/input/event*; do
  [ -c "$ev" ] || continue
  # Opening with exec keeps a persistent fd so we can poll all devices in
  # parallel from one background job.
  if exec 9<> "$ev" 2>/dev/null; then
    DEVS="$DEVS $ev"
    exec 9>&-
  fi
done

# Evdev input_event layout: timeval(2x8B on 64-bit / 2x4B on 32-bit), then
# u16 type, u16 code, s32 value. type=1 (EV_KEY) + value=1 (press) is what we
# want. Parsing approach: take the LAST 8 bytes of every 16-byte (32-bit
# timeval) or 24-byte (64-bit timeval) record. We detect the record size by
# counting how many bytes arrive: volume keys typically emit one 24B or 16B
# block per event; we tail the raw stream and parse pragmatically.
#
# shell cannot binary-parse reliably across busybox variants, so we use od:
# read raw bytes, locate the value field by scanning for type=0001 groups.
#
# parse_events <raw-bytes-file> -> echoes "up" | "down" | "power" | ""
parse_events() {
  # od -An -tx1 gives two hex chars per byte with spaces/newlines.
  # Walk 4-byte little-endian words: the last 8 bytes of each event are
  # (u16 type, u16 code, s32 value). We scan hex pairs and find positions
  # where pair[i]='01' (type=EV_KEY) then read the next two pairs as code.
  od -An -v -tx1 "$1" 2>/dev/null | tr -s ' \n' ' ' | awk '
    {
      n = 0
      for (i = 1; i <= NF; i++) { n++; h[n] = $i }
      # scan every offset: records may not be perfectly aligned in the
      # captured stream. An event needs 8 pairs (type, code, 4B value), so
      # the guard is p+7<=n - using p+8 would skip the last record, which
      # is exactly where a captured keypress usually sits.
      for (p = 1; p + 7 <= n; p++) {
        if (found) break
        for (s = 1; s <= 2 && !found; s++) {
          stride = (s == 1) ? 24 : 16
          q = p
          while (q + 7 <= n && !found) {
            # type (u16 LE) then code (u16 LE) then value (s32 LE)
            if (h[q] == "01" && h[q+1] == "00") {
              codehex = h[q+3] h[q+2]
              valhex  = h[q+4] h[q+5] h[q+6] h[q+7]
              if (valhex == "01000000") {
                # hex comparison only (no strtonum): gawk/mawk/busybox safe
                if (codehex == "0073")      { print "up";    found = 1 }
                else if (codehex == "0072") { print "down";  found = 1 }
                else if (codehex == "0074") { print "power"; found = 1 }
              }
            }
            q += stride
          }
        }
      }
    }
    END { if (!found) print "" }
  ' | head -n 1
}

# ---------------------------------------------------------------------------
# read_key: background-reader + wait policy.
# Runs `cat` on all input devices in parallel, waits for a keypress, then
# parses what arrived. Sets VOLKEY: up | down | power | ""
#
# Wait policy: until the user presses anything in the CURRENT menu
# (GOTKEY=0), the probe waits up to PROBE_S seconds for the first keypress
# and gives up silently for an unattended flash. Once ONE keypress is
# captured the user is considered interactive and every further wait is
# UNLIMITED - the menu never chooses for them again.
GOTKEY=0
PROBE_S=10
# ---------------------------------------------------------------------------
read_key() {
  VOLKEY=""
  RAW=/tmp/.kd_raw
  : > "$RAW"
  if [ -n "$DEVS" ]; then
    # shellcheck disable=SC2086
    ( for d in $DEVS; do cat "$d" >> "$RAW" 2>/dev/null & done; wait ) &
    READER=$!
    if [ "$GOTKEY" = "1" ]; then
      # interactive user: wait indefinitely for the next keypress
      while :; do [ -s "$RAW" ] && break; sleep 1; done
    else
      # first contact: bounded probe so unattended flashes proceed
      _t=0
      while [ "$_t" -lt "$PROBE_S" ]; do
        [ -s "$RAW" ] && break
        sleep 1
        _t=$((_t+1))
      done
    fi
    kill "$READER" 2>/dev/null
    # kill the nested cat jobs too
    pkill -P "$READER" 2>/dev/null
    wait "$READER" 2>/dev/null
  else
    # no input device: probe briefly so menus do not hang forever
    sleep 3
    echo "" > "$RAW"
  fi
  VOLKEY=$(parse_events "$RAW")
  : > "$RAW"
  [ -n "$VOLKEY" ] && GOTKEY=1
}

# ---------------------------------------------------------------------------
# menu: ask <default-index> <title> <option1> <option2> [...]
# answer in MENU_SEL (1-based index). The default is preselected and chosen
# when the user presses Power without moving, or when no keys are ever
# received (non-interactive environment). There is NO timeout: the menu
# waits as long as the user needs.
#
# Rendering example:
#   1) Choose a preset:
#      [1] Safe (recommended)
# ==>  [2] Default                <-- current selection, reprinted on change
#      [3] Maximum
#      [4] Keep my current list
#   Vol+ = next option, Vol- = confirm - the menu never times out
#   (Power is deliberately ignored: in recovery it blanks the screen)
# ---------------------------------------------------------------------------
MENU_SEL=0
ask() {
  GOTKEY=0          # each menu starts in bounded-probe mode again
  _def="$1"; shift
  _title="$1"; shift
  _n=0
  for _opt in "$@"; do _n=$((_n+1)); eval "_opt$_n=\$_opt"; done

  ui_print " "
  ui_print " $_title"
  _i=1
  while [ "$_i" -le "$_n" ]; do
    eval "_v=\$_opt$_i"
    if [ "$_i" = "$_def" ]; then
      ui_print " ==> [$_i] $_v"
    else
      ui_print "     [$_i] $_v"
    fi
    _i=$((_i+1))
  done
  ui_print "  $STR_HINT"

  _cur=$_def
  while :; do
    read_key
    case "$VOLKEY" in
      "")
        # probe found nothing (unattended flash or no input devices):
        # accept the preselected default, silently
        break
        ;;
      up)
        # Vol+ cycles to the next option and reprints the menu
        _cur=$((_cur+1)); [ "$_cur" -gt "$_n" ] && _cur=1
        _i=1
        while [ "$_i" -le "$_n" ]; do
          eval "_v=\$_opt$_i"
          if [ "$_i" = "$_cur" ]; then ui_print " ==> [$_i] $_v"
          else ui_print "     [$_i] $_v"; fi
          _i=$((_i+1))
        done
        ;;
      down)
        # Vol- confirms the currently highlighted option
        break
        ;;
      power)
        # ignored on purpose: Power blanks the recovery screen.
        # re-show the hint so the user learns the correct keys.
        ui_print "  $STR_IGNORE"
        ;;
      *)
        ;;
    esac
  done

  # the default is returned when the user never pressed anything;
  # if they confirmed a moved selection with Vol-, _cur is already correct.
  [ "$_cur" -ge 1 ] 2>/dev/null || _cur=$_def
  [ "$_cur" -le "$_n" ] || _cur=$_def
  MENU_SEL=$_cur
}

# ---------------------------------------------------------------------------
# /data
# ---------------------------------------------------------------------------
if ! grep -qs " /data " /proc/mounts; then
  mount /data 2>/dev/null
fi
if ! grep -qs " /data " /proc/mounts; then
  mount -t ext4 /dev/block/bootdevice/by-name/userdata /data 2>/dev/null
fi

ui_print " "
ui_print " Universal Debloat - interactive installer"
ui_print " systemless: no ROM partition is modified"

if ! grep -qs " /data " /proc/mounts; then
  ui_print "- /data unavailable, using bundled default list"
  NONINTERACTIVE=1
else
  NONINTERACTIVE=0
fi

# a "noask" marker inside the zip skips the menus (silent install)
if [ "$NONINTERACTIVE" = "0" ]; then
  unzip -o "$ZIPFILE" noask -d /tmp >/dev/null 2>&1 && [ -f /tmp/noask ] && {
    NONINTERACTIVE=1
    ui_print "- noask marker found: silent install"
    rm -f /tmp/noask
  }
fi

if [ -z "$DEVS" ]; then
  ui_print "- no input devices found: menus will use defaults"
fi

# ---------------------------------------------------------------------------
# strings (English only)
# ---------------------------------------------------------------------------
STR_PRESET_T="1) Choose a preset:"
STR_PRESET_1="Safe (recommended)"
STR_PRESET_2="Default"
STR_PRESET_3="Maximum"
STR_PRESET_4="Keep my current list"
STR_ACTION_T="2) Choose an action:"
STR_ACTION_1="Uninstall (hidden)"
STR_ACTION_2="Disable (recommended)"
STR_CLEAN_T="3) Clean ROM mode?"
STR_CLEAN_1="No (keep setup wizard)"
STR_CLEAN_2="Yes (skip first-boot wizard)"
STR_HINT="Vol+ = next option, Vol- = confirm - no time limit"
STR_IGNORE="(Power ignored - use Vol+ to move, Vol- to confirm)"
STR_CHOSEN="-> confirmed:"
STR_MOVED="-> moved to option"
STR_GONE="fully hidden from user 0 (restored by deleting the module)"
STR_DIS="shows as Disabled in settings - the safest choice"
STR_WIZ="first-boot setup wizard will be skipped"
STR_WIZNO="first-boot setup wizard stays as-is"
STR_CONFNEW="config written to:"
STR_CONFKEEP="keeping existing config:"
STR_DONE="installed to:"
STR_REBOOT="takes effect after next reboot"
STR_RESTORE="deleting the module restores the apps"

# ---------------------------------------------------------------------------
# menu 1: preset
# ---------------------------------------------------------------------------
if [ "$NONINTERACTIVE" = "0" ]; then
  case "$PRESET_NAME_SAVED" in default) _d=2 ;; max) _d=3 ;; keep) _d=4 ;; *) _d=1 ;; esac
  ask "$_d" "$STR_PRESET_T" "$STR_PRESET_1" "$STR_PRESET_2" "$STR_PRESET_3" "$STR_PRESET_4"
  PSEL=$MENU_SEL
else
  case "$ZIPFILE" in
    *preset-default*) PSEL=2 ;;
    *preset-max*)     PSEL=3 ;;
    *)                PSEL=1 ;;
  esac
fi
case $PSEL in
  1) PRESET=safe;    PRESET_NAME=$STR_PRESET_1 ;;
  2) PRESET=default; PRESET_NAME=$STR_PRESET_2 ;;
  3) PRESET=max;     PRESET_NAME=$STR_PRESET_3 ;;
  4) PRESET=keep;    PRESET_NAME=$STR_PRESET_4 ;;
  *) PRESET=safe;    PRESET_NAME=$STR_PRESET_1 ;;
esac
ui_print " $STR_CHOSEN $PRESET_NAME"

# ---------------------------------------------------------------------------
# menu 2: action
# ---------------------------------------------------------------------------
if [ "$NONINTERACTIVE" = "0" ]; then
  ask 1 "$STR_ACTION_T" "$STR_ACTION_1" "$STR_ACTION_2"
  ASEL=$MENU_SEL
else
  ASEL=1
fi
case $ASEL in
  1) MODE=uninstall; MODE_NAME="$STR_ACTION_1 ($STR_GONE)" ;;
  *) MODE=disable;   MODE_NAME="$STR_ACTION_2 ($STR_DIS)" ;;
esac
ui_print " $STR_CHOSEN $MODE_NAME"

# ---------------------------------------------------------------------------
# menu 3: clean ROM
# ---------------------------------------------------------------------------
if [ "$NONINTERACTIVE" = "0" ]; then
  ask 1 "$STR_CLEAN_T" "$STR_CLEAN_1" "$STR_CLEAN_2"
  CSEL=$MENU_SEL
else
  CSEL=1
fi
case $CSEL in
  2) CLEANROM=yes ;;
  *) CLEANROM=no ;;
esac
if [ "$CLEANROM" = "yes" ]; then
  ui_print " $STR_CHOSEN $STR_WIZ"
else
  ui_print " $STR_CHOSEN $STR_WIZNO"
fi

# ---------------------------------------------------------------------------
# resolve the modules base directory
# ---------------------------------------------------------------------------
if [ -d /data/adb/ksu/modules ]; then
  BASE=/data/adb/ksu/modules
  ui_print "- KernelSU detected"
elif [ -d /data/adb/ksu ]; then
  BASE=/data/adb/modules
  ui_print "- KernelSU (ksud) detected"
elif [ -d /data/adb/magisk ]; then
  BASE=/data/adb/magisk
  ui_print "- Magisk detected"
else
  BASE=/data/adb/modules
  ui_print "- no manager dir found, using /data/adb/modules"
fi
mkdir -p "$BASE"

# ---------------------------------------------------------------------------
# extract the module
# ---------------------------------------------------------------------------
MODDIR="$BASE/$MODID"
rm -rf "$MODDIR"
mkdir -p "$MODDIR"

ui_print "- extracting module files"
unzip -o "$ZIPFILE" module.prop service.sh post-fs-data.sh uninstall.sh customize.sh blank.apk hide_list.txt README.txt -d "$MODDIR" >/dev/null 2>&1 \
  || abort "unzip failed"

chmod 644 "$MODDIR/module.prop" "$MODDIR/blank.apk" "$MODDIR/customize.sh" "$MODDIR/hide_list.txt" "$MODDIR/README.txt" 2>/dev/null
chmod 755 "$MODDIR/service.sh" "$MODDIR/post-fs-data.sh" "$MODDIR/uninstall.sh" 2>/dev/null
chown 0:0 "$MODDIR" "$MODDIR"/* 2>/dev/null
command -v restorecon >/dev/null 2>&1 && restorecon -R "$BASE" 2>/dev/null

# ---------------------------------------------------------------------------
# write the user's chosen config (preset + action + cleanrom)
# ---------------------------------------------------------------------------
GENLIST="$MODDIR/hide_list.txt"
if [ "$PRESET" != "keep" ] && [ -f "$ZIPFILE" ]; then
  unzip -o "$ZIPFILE" "presets/$PRESET.txt" -d /tmp >/dev/null 2>&1 && [ -f "/tmp/presets/$PRESET.txt" ] && GENLIST="/tmp/presets/$PRESET.txt"
fi
sed "s/^@mode=.*/@mode=$MODE/" "$GENLIST" > "$MODDIR/hide_list.txt.new" 2>/dev/null \
  && mv "$MODDIR/hide_list.txt.new" "$MODDIR/hide_list.txt"

if [ ! -f "$CONF" ] || [ "$PRESET" != "keep" ]; then
  cp -f "$MODDIR/hide_list.txt" "$CONF"
  chmod 644 "$CONF"
  ui_print "- $STR_CONFNEW $CONF"
else
  ui_print "- $STR_CONFKEEP $CONF"
fi

if [ "$CLEANROM" = "yes" ]; then
  touch "$CLEANFLAG"
  chmod 644 "$CLEANFLAG"
else
  rm -f "$CLEANFLAG"
fi

rm -rf /tmp/presets 2>/dev/null

ui_print " "
ui_print "- $STR_DONE $MODDIR"
ui_print "- $STR_REBOOT"
ui_print "- $STR_RESTORE"
ui_print " "
exit 0
